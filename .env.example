# Copia este archivo como .env y rellena los valores. .env nunca se sube a git.

# Zernio: el plugin oficial usa OAuth (no hace falta clave).
# Solo si se configura el servidor MCP con clave en lugar de OAuth:
# https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=

# open-carrusel lee su propia ruta al CLI de Claude desde herramientas/open-carrusel/.env.local
# (la crea su script de setup). Referencia en Windows:
# CLAUDE_CLI_PATH=C:\Users\<usuario>\AppData\Roaming\npm\claude.cmd
